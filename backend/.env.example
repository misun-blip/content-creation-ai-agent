# 内容创作AI-Agent 配置文件示例
# 复制此文件为 .env 并修改相应的配置值

# ==================== 应用配置 ====================
APP_NAME=内容创作AI-Agent
APP_VERSION=1.0.0
DEBUG=true

# ==================== 数据库配置 ====================
# MySQL（默认，新团队开发环境）
DATABASE_URL=mysql+pymysql://content_ai:content_ai_password@localhost:3306/content_ai_agent

# SQLite（仅用于快速本地测试，不推荐）
# DATABASE_URL=sqlite:///./test.db

# PostgreSQL示例
# DATABASE_URL=postgresql://user:password@localhost:5432/content_agent

# ==================== Redis配置 ====================
# 本地Redis
REDIS_URL=redis://localhost:6379/0

# Redis with password
# REDIS_URL=redis://:password@localhost:6379/0

# ==================== JWT配置 ====================
# 生产环境请务必修改此密钥！
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== AI服务配置 ====================
# OpenAI API配置（可选，平台适配模块不需要）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 通义千问API配置（可选）
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 百度文心一言API配置（可选）
# BAIDU_API_KEY=your-baidu-api-key-here
# BAIDU_SECRET_KEY=your-baidu-secret-key-here

# ==================== CORS配置 ====================
# 允许的前端地址，多个地址用逗号分隔
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
