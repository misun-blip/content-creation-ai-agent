# 内容创作AI-Agent 后端配置文件
# 使用方法：复制此文件为 .env，然后填写实际的 API Key
#   cp .env.example .env

# ==================== 应用配置 ====================
APP_NAME=内容创作AI-Agent
APP_VERSION=1.0.0
DEBUG=true

# ==================== 数据库配置 ====================
# MySQL（Docker 容器，端口映射 3307:3306）
DATABASE_URL=mysql+pymysql://content_ai:content_ai_password@localhost:3307/content_ai_agent

# ==================== Redis配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== JWT配置 ====================
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== AI服务配置 ====================
# 填写你的 API Key（支持 OpenAI / ChatAnywhere 等转发服务）
AI_API_KEY=你的API-Key
AI_API_BASE=https://api.chatanywhere.tech/v1
